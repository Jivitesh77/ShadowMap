# Copy this file to .env and fill in values. NEVER commit .env or share its contents.

# Where the SQLite database file lives (relative to the backend folder).
DATABASE_URL=sqlite:///data/shadowmap.db

# true = shortened walk timers and help-call buttons ring DEMO_CALL_NUMBER instead of real helplines.
DEMO_MODE=true

# Phone number of a team member that demo help calls ring instead of 112/181/100. Filled in at milestone M10.
DEMO_CALL_NUMBER=

# Google Gemini key (from aistudio.google.com). Filled in at milestone M6.
GEMINI_API_KEY=
# Gemini model id (see ai.google.dev/gemini-api/docs/models). Default: gemini-3.5-flash-lite
GEMINI_MODEL=

# Optional: Google Places API (New) key for supplementary place search. Leave empty to turn the feature off.
# Results are only listed in a separate panel with "Google Maps" attribution, never drawn on the map, never stored.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_MAX_PER_HOUR=30

# Access code for Sentinel (photos, videos, rider routes). Required: without it Sentinel is switched off.
# Make one with: python3 -c "import secrets; print(secrets.token_urlsafe(12))"
SENTINEL_TOKEN=

# Blueprint rules enforced by the server. Set to false ONLY while testing in daytime or on foot.
SENTINEL_ENFORCE_NIGHT=true
SENTINEL_ENFORCE_MOVING=true

# Access code for the (simulated) police dashboard. Required to open it.
POLICE_TOKEN=

# Walk With Me demo timers in seconds (defaults when DEMO_MODE=true: stop 15, off-route 15, late 60, ask 20, contacts->police 30).
# WALK_STOP_S=15
# WALK_ASK_S=20
# WALK_CONTACTS_TO_POLICE_S=30

# Where the database, photos and uploads live. Leave empty locally (backend/data). Hosted: a persistent disk, e.g.
# DATA_DIR=/var/data  and  DATABASE_URL=sqlite:////var/data/shadowmap.db
DATA_DIR=

# Frontend address(es) allowed to call this backend when hosted separately (comma-separated, no trailing slash).
# Locally the default (http://localhost:5173) is used when empty.
# CORS_ORIGINS=https://your-frontend.vercel.app
