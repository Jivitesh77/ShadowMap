# Frontend settings (copy to frontend/.env for local overrides; set them in Vercel for production).
# Backend address in production, e.g. https://shadowmap-backend.onrender.com  (leave empty for local development).
VITE_API_BASE=
# Optional other map tile server for Leaflet (default: OpenStreetMap). Do not use Google tiles.
VITE_TILE_URL=
VITE_TILE_ATTRIBUTION=
